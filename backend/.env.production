NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/nirmaan_prod?retryWrites=true&w=majority
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION_USE_32_CHAR_RANDOM_STRING
JWT_EXPIRY=7d
OTP_EXPIRY_MINUTES=10
APP_BASE_URL=https://your-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=https://your-domain.com

# File Upload Limits
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Email (Use environment-specific credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-production-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@your-domain.com

# Twilio SMS (Use production credentials)
TWILIO_ACCOUNT_SID=your-production-sid
TWILIO_AUTH_TOKEN=your-production-token
TWILIO_FROM_NUMBER=your-production-number

# DeepSeek AI
DEEPSEEK_API_KEY=your-production-api-key

# Google Sheets
GOOGLE_SHEETS_ATTENDANCE_URL=https://docs.google.com/spreadsheets/d/your-production-sheet-id/edit

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=change-this-session-secret
