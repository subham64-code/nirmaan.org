NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nirmaan_org
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRY=7d
OTP_EXPIRY_MINUTES=10
APP_BASE_URL=http://localhost:3000

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=no-reply@nirmaan.org

# Alternate email variable names supported by the app
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_API_KEY=

# Twilio SMS (for SMS notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_API_KEY=
sid=

# DeepSeek AI (for smart student recommendations)
DEEPSEEK_API_KEY=

# Ollama AI (optional API key if using a hosted Ollama-compatible endpoint)
OLLAMA_API_KEY=

# Optional public integrations used by the frontend
GOOGLE_MAPS_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GEMINI_API_KEY=

# Google Sheets Attendance Tracking
GOOGLE_SHEETS_ATTENDANCE_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit?usp=sharing
